@model DmcDashboardViewModel
@{
    ViewData["Title"] = "DMC Workspace";
    static string Short(string value, string fallback) => string.IsNullOrWhiteSpace(value) || value == "No Preference" ? fallback : value;
}
<section id="dmc" class="page active"><header class="top"><div class="brand">DMC<i>Grid</i></div><div class="nav"><span class="userTag">@User.FindFirst("org")?.Value</span><form method="post" asp-controller="Account" asp-action="Logout" style="margin:0"><button class="btn" type="submit">Logout</button></form></div></header><div class="shell"><div class="titleRow"><div><span class="eyebrow">DMC WORKSPACE</span><h1>Matched RFQs</h1></div></div><div class="stats"><div class="stat"><small>NEW MATCHES</small><b>@Model.Stats.A</b></div><div class="stat"><small>QUOTES SENT</small><b>@Model.Stats.B</b></div><div class="stat"><small>CONNECTED</small><b>@Model.Stats.C</b></div><div class="stat"><small>QUOTE CREDITS</small><b>@Model.Stats.D</b></div></div><div class="queue"><div class="qrow head"><span>RFQ</span><span>TRAVEL</span><span>REQUIREMENT</span><span>MATCH</span><span>ACTION</span></div>
@foreach (var r in Model.Rfqs)
{
    var food = r.FoodPrefs.Split(',', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Any food";
    <a class="qrow click" asp-controller="Quote" asp-action="Builder" asp-route-id="@r.RfqId" style="color:inherit;text-decoration:none"><div><b>@r.Destination · @r.RfqNo</b><div class="sub">@(r.Connected ? "Connected travel agent" : "Anonymous travel agent")@(r.Status == RfqStatus.Closed ? " · RFQ closed" : "")</div></div><div>@r.TravelLabel</div><div>@Short(r.HotelCategory, "Any hotel") · @Short(r.Vehicle, "Any vehicle") · @food</div><b>@(r.BestMatch is int m ? m + "%" : "New")</b><span class="btn @(r.HasQuote ? "" : "primary")" style="text-align:center">@(r.HasQuote ? (r.Connected ? "Revise Quote" : "Edit Quote") : "Create Quote")</span></a>
}
@if (Model.Rfqs.Count == 0)
{
    <div class="qrow"><div class="sub">No matched RFQs right now. New requests for your destinations appear here.</div></div>
}
</div></div></section>
