@model AgentDashboardViewModel
@{
    ViewData["Title"] = "Agent Workspace";
}
<section id="agent" class="page active"><header class="top"><div class="brand">DMC<i>Grid</i></div><div class="nav"><span class="userTag">@User.FindFirst("org")?.Value</span><a class="btn coral" asp-controller="Rfq" asp-action="Create">+ New RFQ</a><form method="post" asp-controller="Account" asp-action="Logout" style="margin:0"><button class="btn" type="submit">Logout</button></form></div></header><div class="shell"><div class="titleRow"><div><span class="eyebrow">AGENT WORKSPACE</span><h1>RFQ Operations</h1></div></div><div class="stats"><div class="stat"><small>LEADS REMAINING</small><b>@Model.Stats.A</b></div><div class="stat"><small>ACTIVE RFQs</small><b>@Model.Stats.B</b></div><div class="stat"><small>QUOTES RECEIVED</small><b>@Model.Stats.C</b></div><div class="stat"><small>NEEDS ACTION</small><b>@Model.Stats.D</b></div></div><div class="queue"><div class="qrow head"><span>RFQ / DESTINATION</span><span>TRAVEL</span><span>QUOTES</span><span>CONNECTION</span><span>STATUS</span></div>
@foreach (var r in Model.Rfqs)
{
    var draft = r.Status == RfqStatus.Draft;
    var (label, warn) = r.Status switch
    {
        RfqStatus.Draft => ("Draft", true),
        RfqStatus.Closed => ("Closed", true),
        _ when r.ConnectionCount > 0 => ("Connected", false),
        _ when r.OptionCount > 0 => ("Review", true),
        _ => ("Awaiting quotes", false)
    };
    <a class="qrow click" href="@(draft ? Url.Action("Create", "Rfq", new { id = r.RfqId }) : Url.Action("Index", "Compare", new { id = r.RfqId }))" style="color:inherit;text-decoration:none"><div><b>@(r.Destination.Length > 0 ? r.Destination : "Untitled") · @r.RfqNo</b><div class="sub">@r.Cities.Replace(" / ", " → ")</div></div><div>@r.TravelLabel</div><div><b>@r.OptionCount option@(r.OptionCount == 1 ? "" : "s")</b><div class="sub">@r.DmcCount DMC@(r.DmcCount == 1 ? "" : "s")</div></div><div>@r.ConnectionCount of 2</div><span><span class="pill @(warn ? "warn" : "")">@label</span></span></a>
}
@if (Model.Rfqs.Count == 0)
{
    <div class="qrow"><div class="sub">No RFQs yet — create your first RFQ to reach matched DMCs.</div></div>
}
</div></div></section>
